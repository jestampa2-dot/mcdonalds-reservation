{
  "expo": {
    "name": "McDonalds Reservations Mobile",
    "slug": "mcdonalds-reservations-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcdreservations",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mcdbooker.reservations",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow McDonalds Reservations Mobile to use Face ID to protect your account."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#DA291C",
          "defaultChannel": "booking-reminders"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow McDonalds Reservations Mobile to scan customer event QR passes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b694d79-7bcf-47c4-815a-64fd85c0ec5f"
      }
    }
  }
}
